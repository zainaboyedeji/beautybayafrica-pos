{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://beautybayafrica-pos-app.onrender.com",
      "http://localhost:3000"
    ]
  },
  "permissions": [
    "core:default",
    "allow-print-receipt",
    "allow-list-printer-ports",
    "allow-print-raw"
  ]
}

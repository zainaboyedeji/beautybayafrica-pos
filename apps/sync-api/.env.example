# Copy this file to .env and fill it in. Never commit .env.

# Password for the admin (back office) login.
ADMIN_PASSWORD=

# Long random text used to sign logins. If empty, everyone is logged out
# whenever the server restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 when running behind a hosting proxy such as Render.
# TRUST_PROXY=1

# Website sync. Every night at 1am (Lagos time), prices, names, SKUs, photos and
# new products are copied from the online shop (never stock, cost or
# barcodes), in case a webhook below was missed.
# WOOCOMMERCE_URL=https://beautybayafrica.com
# WOOCOMMERCE_SYNC_HOUR=1
# Set to off on a computer that shouldn't sync, e.g. while testing.
# WOOCOMMERCE_SYNC=off

# Secret of the WooCommerce webhook (Settings → Advanced → Webhooks) that
# sends website product changes here as they happen.
WOOCOMMERCE_WEBHOOK_SECRET=

# Copy this file to .env and fill it in. Never commit .env.

# Password for the admin (back office) login.
ADMIN_PASSWORD=

# Long random text used to sign logins. If empty, everyone is logged out
# whenever the server restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 when running behind a hosting proxy such as Render.
# TRUST_PROXY=1
